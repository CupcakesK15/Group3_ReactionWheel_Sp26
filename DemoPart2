def get_flywheel_rpm() -> float:
    global _last_steps, _last_enc_t
    now   = time.time()
    dt    = now - _last_enc_t
    steps = encoder.steps
    ticks = steps - _last_steps
    _last_steps = steps
    _last_enc_t = now
    if dt <= 0:
        return 0.0
    return (ticks / TICKS_PER_REV / dt) * 60.0

