import RPi.GPIO as GPIO
import time

# --- Pin Configuration ---
# BTS7960 RPWM (Right PWM) -> GPIO 12
# BTS7960 LPWM (Left PWM)  -> GPIO 13
# BTS7960 R_EN and L_EN should be connected to 3.3V
RPWM = 12
LPWM = 13

# --- Setup ---
GPIO.setmode(GPIO.BCM)
GPIO.setup(RPWM, GPIO.OUT)
GPIO.setup(LPWM, GPIO.OUT)

# Set frequency to 1kHz (standard for motor control)
pwm_r = GPIO.PWM(RPWM, 1000)
pwm_l = GPIO.PWM(LPWM, 1000)

pwm_r.start(0)
pwm_l.start(0)

def test_motor(power):
    """
    power: -100 to 100
    Positive = Clockwise, Negative = Counter-Clockwise
    """
    if power >= 0:
        print(f"Spinning Clockwise at {power}% power...")
        pwm_r.ChangeDutyCycle(power)
        pwm_l.ChangeDutyCycle(0)
    else:
        print(f"Spinning Counter-Clockwise at {abs(power)}% power...")
        pwm_r.ChangeDutyCycle(0)
        pwm_l.ChangeDutyCycle(abs(power))

try:
    # 1. Run at 50% for 3 seconds
    test_motor(50)
    time.sleep(3)

    # 2. Stop for 1 second
    print("Stopping...")
    test_motor(0)
    time.sleep(1)

    # 3. Run at -50% (Reverse) for 3 seconds
    test_motor(-50)
    time.sleep(3)

except KeyboardInterrupt:
    print("\nManual stop.")

finally:
    print("Cleaning up GPIO.")
    pwm_r.stop()
    pwm_l.stop()
    GPIO.cleanup()