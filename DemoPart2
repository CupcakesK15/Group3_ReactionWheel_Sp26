# Demo Part 2: Find a bright green rectangular object, then follow it
# by PID-ing the contour centre to the frame centre.
#
# Flow:
#   SEARCH — platform spins, smart search uses side zones for direction
#   LOCKED — camera PID drives contour centre to frame centre continuously
#            if object lost for too long → back to SEARCH

import time
import math
import threading
import cv2
import numpy as np
import board
import busio
from adafruit_bno08x.i2c import BNO08X_I2C
from adafruit_bno08x import BNO_REPORT_GYROSCOPE, BNO_REPORT_ROTATION_VECTOR
from gpiozero import PWMOutputDevice, OutputDevice, RotaryEncoder
from gpiozero.pins.lgpio import LGPIOFactory
from gpiozero import Device
from picamera2 import Picamera2

Device.pin_factory = LGPIOFactory()

# ═══════════════════════════════════════════════════════════════════════════════
# TUNING
# ═══════════════════════════════════════════════════════════════════════════════

# --- Motor & Encoder ---
RPWM_PIN      = 12
LPWM_PIN      = 13
R_EN_PIN      = 22
L_EN_PIN      = 23
ENC_A_PIN     = 5
ENC_B_PIN     = 6
TICKS_PER_REV = 14

# --- Camera PID (drives contour centre → frame centre) ---
# Error is normalised horizontal offset: -1.0 (far left) to +1.0 (far right)
# Start with Kp_cam only, add Kd_cam if it overshoots, Ki_cam last if it drifts
Kp_cam = 15.0
Ki_cam = 0.5
Kd_cam = 2.0
MAX_DUTY     = 80.0

# Dead band: if contour centre is within this fraction of frame centre, hold.
# Prevents buzzing when nearly centred.
CAM_DEAD_BAND = 0.05    # 5% of half-frame width

# --- Search ---
SEARCH_DUTY = 8.0      # % duty while scanning — flip sign if wrong direction

# --- Smart search: last-seen direction ---
SIDE_ZONE_W_FRAC    = 0.25
SIDE_FILL_THRESHOLD = 0.04

# --- Camera ---
FRAME_WIDTH  = 160 #og is times 4
FRAME_HEIGHT = 120

# --- Colour (bright grass green) ---
HSV_LOWER = np.array([ 40, 120, 120], dtype=np.uint8)
HSV_UPPER = np.array([ 75, 255, 255], dtype=np.uint8)

# --- Detection thresholds ---
MIN_RECT_AREA = 250    # px² — lower if missing at range, raise to cut noise

# Centre tolerance to trigger initial lock from SEARCH
# (looser than the follow dead band — just needs to be roughly in view)
CENTRE_TOL_X = 0.40
CENTRE_TOL_Y = 0.40

# --- Lost threshold ---
LOST_FRAMES_THRESHOLD = 20

# --- Loop timing ---
CONTROL_HZ     = 120 #og is 50
CONTROL_PERIOD = 1.0 / CONTROL_HZ

# ═══════════════════════════════════════════════════════════════════════════════
# HARDWARE INIT
# ═══════════════════════════════════════════════════════════════════════════════

rpwm  = PWMOutputDevice(RPWM_PIN, frequency=1000)
lpwm  = PWMOutputDevice(LPWM_PIN, frequency=1000)
r_en  = OutputDevice(R_EN_PIN, initial_value=True)
l_en  = OutputDevice(L_EN_PIN, initial_value=True)

encoder     = RotaryEncoder(ENC_A_PIN, ENC_B_PIN, max_steps=0)
_last_steps = 0
_last_enc_t = time.time()

i2c = busio.I2C(board.SCL, board.SDA, frequency=100000)
imu = BNO08X_I2C(i2c)
imu.enable_feature(BNO_REPORT_GYROSCOPE)
imu.enable_feature(BNO_REPORT_ROTATION_VECTOR)

picam = Picamera2()
picam.configure(picam.create_preview_configuration(
    main={"format": "BGR888", "size": (FRAME_WIDTH, FRAME_HEIGHT)}
))
picam.start()
time.sleep(1)

# ═══════════════════════════════════════════════════════════════════════════════
# MOTOR CONTROL
# ═══════════════════════════════════════════════════════════════════════════════

def set_motor(duty: float):
    duty = max(-100.0, min(100.0, duty)) / 100.0
    if duty >= 0:
        rpwm.value = duty
        lpwm.value = 0.0
    else:
        rpwm.value = 0.0
        lpwm.value = -duty

def get_flywheel_rpm() -> float:
    global _last_steps, _last_enc_t
    now   = time.time()
    dt    = now - _last_enc_t
    steps = encoder.steps
    ticks = steps - _last_steps
    _last_steps = steps
    _last_enc_t = now
    if dt <= 0:
        return 0.0
    return (ticks / TICKS_PER_REV / dt) * 60.0

def stop_motor():
    rpwm.value = 0.0
    lpwm.value = 0.0
    r_en.value = 1.0
    l_en.value = 1.0

def cleanup():
    stop_motor()
    rpwm.close(); lpwm.close()
    r_en.close(); l_en.close()
    encoder.close()
    picam.stop()

# ═══════════════════════════════════════════════════════════════════════════════
# IMU (used for logging only in LOCKED — camera PID drives the motor)
# ═══════════════════════════════════════════════════════════════════════════════

def _quat_to_R(qi, qj, qk, qr):
    w, x, y, z = qr, qi, qj, qk
    return [
        [1-2*(y*y+z*z),   2*(x*y-z*w),   2*(x*z+y*w)],
        [  2*(x*y+z*w), 1-2*(x*x+z*z),   2*(y*z-x*w)],
        [  2*(x*z-y*w),   2*(y*z+x*w), 1-2*(x*x+y*y)],
    ]

def get_platform_omega_z() -> float | None:
    gyro = imu.gyro
    quat = imu.quaternion
    if gyro is None or quat is None:
        return None
    gx, gy, gz = gyro
    qi, qj, qk, qr = quat
    R = _quat_to_R(qi, qj, qk, qr)
    return R[2][0]*gx + R[2][1]*gy + R[2][2]*gz

# ═══════════════════════════════════════════════════════════════════════════════
# CAMERA PID
# ═══════════════════════════════════════════════════════════════════════════════

class PID:
    def __init__(self, kp, ki, kd, limit=100.0):
        self.kp = kp; self.ki = ki; self.kd = kd
        self.limit = limit
        self._integral   = 0.0
        self._prev_error = 0.0
        self._prev_time  = None

    def reset(self):
        self._integral   = 0.0
        self._prev_error = 0.0
        self._prev_time  = None

    def compute(self, error: float) -> float:
        now = time.time()
        dt  = (now - self._prev_time) if self._prev_time else CONTROL_PERIOD
        dt  = max(dt, 1e-6)
        self._prev_time = now
        p = self.kp * error
        self._integral += error * dt
        max_i = self.limit / max(self.ki, 1e-9)
        self._integral = max(-max_i, min(max_i, self._integral))
        i = self.ki * self._integral
        d = self.kd * (error - self._prev_error) / dt
        self._prev_error = error
        return max(-self.limit, min(self.limit, p + i + d))

# ═══════════════════════════════════════════════════════════════════════════════
# CAMERA THREAD
# ═══════════════════════════════════════════════════════════════════════════════

_cam_lock      = threading.Lock()
_obj_detected  = False
_obj_cx        = None   # contour centre x in pixels, or None
_last_seen_dir = 0      # -1 left, 0 unknown, +1 right

_cx_tol   = int(FRAME_WIDTH  * CENTRE_TOL_X)
_cy_tol   = int(FRAME_HEIGHT * CENTRE_TOL_Y)
_frame_cx = FRAME_WIDTH  // 2
_frame_cy = FRAME_HEIGHT // 2

_sw         = int(FRAME_WIDTH * SIDE_ZONE_W_FRAC)
_LEFT_ZONE  = (0,               0, _sw,          FRAME_HEIGHT)
_RIGHT_ZONE = (FRAME_WIDTH-_sw, 0, FRAME_WIDTH,  FRAME_HEIGHT)

def _side_fill(hsv, zone) -> float:
    x1, y1, x2, y2 = zone
    roi  = hsv[y1:y2, x1:x2]
    mask = cv2.inRange(roi, HSV_LOWER, HSV_UPPER)
    return np.sum(mask > 0) / ((x2-x1)*(y2-y1))

def _detect(frame):
    """
    Returns (detected, contour_cx, left_hint, right_hint)
    detected     — largest contour is above MIN_RECT_AREA and roughly centred
    contour_cx   — pixel x of contour centre (even when not locked, if visible)
    """
    hsv  = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    mask = cv2.inRange(hsv, HSV_LOWER, HSV_UPPER)

    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3)) #og is (7, 7)
    mask   = cv2.morphologyEx(mask, cv2.MORPH_OPEN,  kernel)
    mask   = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL,
                                   cv2.CHAIN_APPROX_SIMPLE)

    best_cnt  = None
    best_area = 0
    for cnt in contours:
        area = cv2.contourArea(cnt)
        if area > MIN_RECT_AREA and area > best_area:
            best_area = area
            best_cnt  = cnt

    left_hint  = _side_fill(hsv, _LEFT_ZONE)  >= SIDE_FILL_THRESHOLD
    right_hint = _side_fill(hsv, _RIGHT_ZONE) >= SIDE_FILL_THRESHOLD

    if best_cnt is None:
        return False, None, left_hint, right_hint

    # Use cv2.moments to get the true contour centroid
    M   = cv2.moments(best_cnt)
    if M["m00"] == 0:
        return False, None, left_hint, right_hint

    cnt_cx = int(M["m10"] / M["m00"])
    cnt_cy = int(M["m01"] / M["m00"])

    in_centre = (abs(cnt_cx - _frame_cx) <= _cx_tol and
                 abs(cnt_cy - _frame_cy) <= _cy_tol)

    return in_centre, cnt_cx, left_hint, right_hint


def camera_thread_fn():
    global _obj_detected, _obj_cx, _last_seen_dir
    while True:
        frame = picam.capture_array()
        if frame is None:
            time.sleep(0.01)
            continue

        detected, cnt_cx, left_hint, right_hint = _detect(frame)

        new_dir = _last_seen_dir
        if left_hint and not right_hint:
            new_dir = -1
        elif right_hint and not left_hint:
            new_dir = +1

        with _cam_lock:
            _obj_detected  = detected
            _obj_cx        = cnt_cx
            _last_seen_dir = new_dir


def get_detection():
    """Returns (detected, contour_cx_pixels, last_seen_dir)."""
    with _cam_lock:
        return _obj_detected, _obj_cx, _last_seen_dir

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

SEARCH = "SEARCH"
LOCKED = "LOCKED"

def main():
    cam_thread = threading.Thread(target=camera_thread_fn, daemon=True)
    cam_thread.start()
    print("Camera thread started.")

    print("Warming up IMU for 3 seconds — keep platform still...")
    time.sleep(3)

    cam_pid    = PID(Kp_cam, Ki_cam, Kd_cam, limit=MAX_DUTY)
    state      = SEARCH
    lost_count = 0
    motor_out  = 0.0

    print(f"\nSearching. HSV: {HSV_LOWER} → {HSV_UPPER}")
    print(f"Cam PID: Kp={Kp_cam}  Ki={Ki_cam}  Kd={Kd_cam}")
    print()
    print(f"{'Time':>7} | {'State':>8} | {'ω_z (°/s)':>10} | "
          f"{'Offset':>8} | {'Dir':>4} | {'Motor %':>8}")
    print("-" * 60)

    try:
        while True:
            t0 = time.time()

            omega_z                       = get_platform_omega_z()
            detected, cnt_cx, last_seen_dir = get_detection()

            if omega_z is None:
                time.sleep(0.005)
                continue

            # ── SEARCH ───────────────────────────────────────────────────────
            if state == SEARCH:
                lost_count = 0
                cam_pid.reset()

                if detected:
                    stop_motor()
                    cam_pid.reset()
                    state = LOCKED
                    print(f"\n  ★ Object found! → LOCKED  contour_cx={cnt_cx}px")
                    motor_out = 0.0
                else:
                    duty = -SEARCH_DUTY if last_seen_dir == -1 else SEARCH_DUTY
                    set_motor(duty)
                    motor_out = duty

            # ── LOCKED — camera PID follows contour centre ────────────────────
            elif state == LOCKED:
                if cnt_cx is None:
                    lost_count += 1
                    if lost_count >= LOST_FRAMES_THRESHOLD:
                        stop_motor()
                        cam_pid.reset()
                        state = SEARCH
                        print(f"\n  ✗ Object lost! → SEARCH")
                        motor_out = 0.0
                    # else keep last motor command while briefly lost
                else:
                    lost_count = 0

                    # Normalised error: negative = object left, positive = right
                    # Dividing by _frame_cx gives -1.0 to +1.0 range
                    offset = (cnt_cx - _frame_cx) / _frame_cx

                    if abs(offset) < CAM_DEAD_BAND:
                        # Close enough to centre — hold still
                        stop_motor()
                        cam_pid.reset()
                        motor_out = 0.0
                    else:
                        # PID drives platform toward object
                        motor_out = cam_pid.compute(offset)
                        set_motor(motor_out)

            # ── Console log ───────────────────────────────────────────────────
            dir_str    = {-1: "LEFT", 0: "----", 1: "RGHT"}.get(last_seen_dir, "----")
            offset_str = f"{((cnt_cx-_frame_cx)/_frame_cx):+.3f}" if cnt_cx is not None else "  none"
            omega_deg  = math.degrees(omega_z) if omega_z else 0.0
            print(f"{time.time():>7.2f} | {state:>8} | {omega_deg:>+10.2f} | "
                  f"{offset_str:>8} | {dir_str:>4} | {motor_out:>+8.1f}",
                  end="\r")

            # ── Pace loop ─────────────────────────────────────────────────────
            elapsed = time.time() - t0
            if CONTROL_PERIOD - elapsed > 0:
                time.sleep(CONTROL_PERIOD - elapsed)

    except KeyboardInterrupt:
        print("\n\nInterrupted — shutting down.")

    finally:
        cleanup()
        print("Done.")

if __name__ == "__main__":
    main()