def set_motor(duty: float):
    """duty: -100 to +100 percent."""
    duty = max(-100.0, min(100.0, duty)) / 100.0
    if duty >= 0:
        rpwm.value = duty
        lpwm.value = 0.0
    else:
        rpwm.value = 0.0
        lpwm.value = -duty

def stop_motor():
    rpwm.value = 0.0
    lpwm.value = 0.0
    # r_en.value = 1.0
