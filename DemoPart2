# ═══════════════════════════════════════════════════════════════════════════════
# IMU
# ═══════════════════════════════════════════════════════════════════════════════

def _quat_to_R(qi, qj, qk, qr):
    w, x, y, z = qr, qi, qj, qk
    return [
        [1-2*(y*y+z*z),   2*(x*y-z*w),   2*(x*z+y*w)],
        [  2*(x*y+z*w), 1-2*(x*x+z*z),   2*(y*z-x*w)],
        [  2*(x*z-y*w),   2*(y*z+x*w), 1-2*(x*x+y*y)],
    ]

def get_platform_omega_z() -> float | None:
    gyro = imu.gyro
    quat = imu.quaternion
    if gyro is None or quat is None:
        return None
    gx, gy, gz = gyro
    qi, qj, qk, qr = quat
    R = _quat_to_R(qi, qj, qk, qr)
    return R[2][0]*gx + R[2][1]*gy + R[2][2]*gz

# ═══════════════════════════════════════════════════════════════════════════════
# PID
# ═══════════════════════════════════════════════════════════════════════════════

class PID:
    def __init__(self, kp, ki, kd, limit=100.0):
        self.kp = kp; self.ki = ki; self.kd = kd
        self.limit = limit
        self._integral   = 0.0
        self._prev_error = 0.0
        self._prev_time  = None

    def reset(self):
        self._integral   = 0.0
        self._prev_error = 0.0
        self._prev_time  = None

    def compute(self, error: float) -> float:
        now = time.time()
        dt  = (now - self._prev_time) if self._prev_time else CONTROL_PERIOD
        dt  = max(dt, 1e-6)
        self._prev_time = now
        p = self.kp * error
        self._integral += error * dt
        max_i = self.limit / max(self.ki, 1e-9)
        self._integral = max(-max_i, min(max_i, self._integral))
        i = self.ki * self._integral
        d = self.kd * (error - self._prev_error) / dt
        self._prev_error = error
        return max(-self.limit, min(self.limit, p + i + d))

# ═══════════════════════════════════════════════════════════════════════════════
# CAMERA THREAD — colour + contour detection
# ═══════════════════════════════════════════════════════════════════════════════

_cam_lock     = threading.Lock()
_obj_detected = False   # True when object is big enough AND centred
_obj_rect     = None    # (x, y, w, h) of best rectangle, or None
_obj_area     = 0       # area of best rectangle in pixels²
_last_seen_dir = 0   # -1 = last seen left, +1 = last seen right, 0 = never seen

_cx_tol   = int(FRAME_WIDTH  * CENTRE_TOL_X)
_cy_tol   = int(FRAME_HEIGHT * CENTRE_TOL_Y)
_frame_cx = FRAME_WIDTH  // 2
_frame_cy = FRAME_HEIGHT // 2

def _build_zones():
    # Centre lock zone
    bw = int(FRAME_WIDTH  * CENTRE_TOL_X * 2)  # reuse centre tol for box size
    bh = int(FRAME_HEIGHT * CENTRE_TOL_Y * 2)
    cx = FRAME_WIDTH  // 2
    cy = FRAME_HEIGHT // 2
    centre = (cx - bw//2, cy - bh//2, cx + bw//2, cy + bh//2)

    # Side zones — full height, flanking the frame edges
    sw = int(FRAME_WIDTH * SIDE_ZONE_W_FRAC)
    left  = (0,              0, sw,           FRAME_HEIGHT)
    right = (FRAME_WIDTH-sw, 0, FRAME_WIDTH,  FRAME_HEIGHT)
    return centre, left, right

def _check_side_zone(hsv_frame, zone):
    """Returns fill fraction of target colour in a zone."""
    x1, y1, x2, y2 = zone
    roi  = hsv_frame[y1:y2, x1:x2]
    if DETECT_RED:
        m1 = cv2.inRange(roi, HSV_LOWER_R1, HSV_UPPER_R1)
        m2 = cv2.inRange(roi, HSV_LOWER_R2, HSV_UPPER_R2)
        mask = cv2.bitwise_or(m1, m2)
    else:
        mask = cv2.inRange(roi, HSV_LOWER, HSV_UPPER)
    total  = (x2 - x1) * (y2 - y1)
    filled = int(np.sum(mask > 0))
    return filled / total if total > 0 else 0.0

_, LEFT_ZONE, RIGHT_ZONE = _build_zones()

def _detect_object(frame):
    """
    Returns (detected: bool, rect: tuple|None, area: int)

    1. Convert to HSV
    2. Threshold to isolate target colour (handles red wrap-around if needed)
    3. Clean mask with morphological ops
    4. Find external contours
    5. Fit bounding rectangles, keep largest above MIN_RECT_AREA
    6. Check if largest rectangle is centred within tolerance
    """
    hsv  = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    if DETECT_RED:
        mask1 = cv2.inRange(hsv, HSV_LOWER_R1, HSV_UPPER_R1)
        mask2 = cv2.inRange(hsv, HSV_LOWER_R2, HSV_UPPER_R2)
        mask  = cv2.bitwise_or(mask1, mask2)
    else:
        mask  = cv2.inRange(hsv, HSV_LOWER, HSV_UPPER)

    # Morphological cleanup
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    mask   = cv2.morphologyEx(mask, cv2.MORPH_OPEN,  kernel)
    mask   = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    # Find contours
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL,
                                   cv2.CHAIN_APPROX_SIMPLE)

    best_rect = None
    best_area = 0

    for cnt in contours:
        x, y, w, h = cv2.boundingRect(cnt)
        area = w * h
        if area < MIN_RECT_AREA:
            continue
        if area > best_area:
            best_area = area
            best_rect = (x, y, w, h)

    if best_rect is None:
        hsv_full   = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        left_fill  = _check_side_zone(hsv_full, LEFT_ZONE)
        right_fill = _check_side_zone(hsv_full, RIGHT_ZONE)
        left_hint  = left_fill  >= SIDE_FILL_THRESHOLD
        right_hint = right_fill >= SIDE_FILL_THRESHOLD
        return False, None, 0, left_hint, right_hint

    x, y, w, h = best_rect
    rect_cx = x + w // 2
    rect_cy = y + h // 2
    in_centre = (abs(rect_cx - _frame_cx) <= _cx_tol and
                 abs(rect_cy - _frame_cy) <= _cy_tol)

    # Check side zones using the already-converted HSV
    # (add hsv as a parameter, or recompute — easiest to recompute since it's cheap)
    # Add this right before the final return:
    hsv_full     = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    left_fill    = _check_side_zone(hsv_full, LEFT_ZONE)
    right_fill   = _check_side_zone(hsv_full, RIGHT_ZONE)
    left_hint    = left_fill  >= SIDE_FILL_THRESHOLD
    right_hint   = right_fill >= SIDE_FILL_THRESHOLD

    return in_centre, best_rect, best_area, left_hint, right_hint


def camera_thread_fn():
    global _obj_detected, _obj_rect, _obj_area, _last_seen_dir

    while True:
        frame = picam.capture_array()
        if frame is None:
            time.sleep(0.01)
            continue

        detected, rect, area, left_hint, right_hint = _detect_object(frame)

        # Update last seen direction whenever we get a side hint
        new_dir = _last_seen_dir
        if left_hint and not right_hint:
            new_dir = -1    # last seen left
        elif right_hint and not left_hint:
            new_dir = +1    # last seen right

        with _cam_lock:
            _obj_detected  = detected
            _obj_rect      = rect
            _obj_area      = area
            _last_seen_dir = new_dir


def get_detection() -> tuple[bool, tuple | None, int, int]:
    """Returns (detected, rect, area, last_seen_dir)."""
    with _cam_lock:
        return _obj_detected, _obj_rect, _obj_area, _last_seen_dir

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

SEARCH = "SEARCH"
LOCKED = "LOCKED"
LOST   = "LOST"

def main():
    # ── Start camera thread ───────────────────────────────────────────────────
    cam_thread = threading.Thread(target=camera_thread_fn, daemon=True)
    cam_thread.start()
    print("Camera thread started.")

    # ── Warm up IMU ──────────────────────────────────────────────────────────
    print("Warming up IMU for 3 seconds — keep platform still...")
    time.sleep(3)

    pid         = PID(Kp, Ki, Kd, limit=MAX_DUTY)
    state       = SEARCH
    lost_count  = 0
    motor_out   = 0.0
    _was_active = False

    print(f"\nStarting. HSV range: {HSV_LOWER} → {HSV_UPPER}")
    print(f"Min rect area: {MIN_RECT_AREA}px²  |  "
          f"Centre tol: ±{CENTRE_TOL_X*100:.0f}% x  ±{CENTRE_TOL_Y*100:.0f}% y")
    print()
    print(f"{'Time':>7} | {'State':>8} | {'ω_z (rad/s)':>12} | "
      f"{'ω_z (°/s)':>10} | {'Rect area':>10} | {'Dir':>4} | {'Motor %':>8}")
    print("-" * 79)

    try:
        while True:
            t0 = time.time()

            omega_z = get_platform_omega_z()
            detected, rect, area, last_seen_dir = get_detection()

            if omega_z is None:
                time.sleep(0.005)
                continue

            # ── State machine ─────────────────────────────────────────────────
            if state == SEARCH:
                lost_count  = 0
                _was_active = False
                pid.reset()

                if detected:
                    state = LOCKED
                    stop_motor()
                    pid.reset()
                    x, y, w, h = rect
                    print(f"\n  ★ Object found! → LOCKED  "
                          f"rect=({x},{y},{w},{h})  area={area}px²")
                    motor_out = 0.0
                else:
                    if last_seen_dir == -1:
                        set_motor(-SEARCH_DUTY)   # last seen left — spin left
                        motor_out = -SEARCH_DUTY
                    elif last_seen_dir == +1:
                        set_motor(+SEARCH_DUTY)   # last seen right — spin right
                        motor_out = +SEARCH_DUTY
                    else:
                        set_motor(+SEARCH_DUTY)   # never seen — default spin
                        motor_out = +SEARCH_DUTY

            elif state == LOCKED:
                if not detected:
                    lost_count += 1
                    if lost_count >= LOST_FRAMES_THRESHOLD:
                        state = LOST
                        print(f"\n  ✗ Object lost! → SEARCH")
                else:
                    lost_count = 0

                if abs(omega_z) < DEAD_BAND_RAD_S:
                    if _was_active:
                        stop_motor()
                        _was_active = False
                    else:
                        rpwm.value = 0.0
                        lpwm.value = 0.0
                    pid.reset()
                    motor_out = 0.0
                else:
                    _was_active = True
                    error     = -omega_z
                    motor_out = pid.compute(error)
                    set_motor(motor_out)

            elif state == LOST:
                stop_motor()
                time.sleep(0.5)
                pid.reset()
                state       = SEARCH
                lost_count  = 0
                _was_active = False
                motor_out   = 0.0

            # ── Console log ───────────────────────────────────────────────────
            dir_str  = {-1: "LEFT", 0: "----", 1: "RGHT"}.get(last_seen_dir, "----")
            area_str = f"{area}px²" if rect is not None else "none"
            print(f"{time.time():>7.2f} | {state:>8} | {omega_z:>+12.4f} | "
                f"{math.degrees(omega_z):>+10.2f} | {area_str:>10} | "
                f"{dir_str:>4} | {motor_out:>+8.1f}",
                end="\r")

            # ── Pace loop ─────────────────────────────────────────────────────
            elapsed = time.time() - t0
            if CONTROL_PERIOD - elapsed > 0:
                time.sleep(CONTROL_PERIOD - elapsed)

    except KeyboardInterrupt:
        print("\n\nInterrupted — shutting down.")

    finally:
        cleanup()
        print("Done.")

if __name__ == "__main__":
    main()