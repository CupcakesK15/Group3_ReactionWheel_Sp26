# --- Motor & Encoder ---
RPWM_PIN      = 12
LPWM_PIN      = 13
R_EN_PIN      = 22
L_EN_PIN      = 23
ENC_A_PIN     = 5
ENC_B_PIN     = 6
TICKS_PER_REV = 14

# --- Stabiliser PID ---
Kp = 45.0
Ki = 0.5
Kd = 0.55
DEAD_BAND_RAD_S = 0.007
MAX_DUTY        = 80.0

# --- Search ---
SEARCH_DUTY = 10.0      # % duty — flip sign if spinning wrong direction

# --- Smart search zones ---
SIDE_ZONE_W_FRAC    = 0.25   # each side zone is 25% of frame width
SIDE_FILL_THRESHOLD = 0.04   # 4% of side zone filled triggers a hint

# --- Camera ---
CAMERA_INDEX = 0
FRAME_WIDTH  = 640
FRAME_HEIGHT = 480

# --- Colour detection (HSV) ---
# OpenCV HSV ranges: H 0-179, S 0-255, V 0-255
# Common starting points:
#   Yellow:  lower=[ 20,100,100]  upper=[ 35,255,255]
#   Orange:  lower=[  5,150,150]  upper=[ 20,255,255]
#   Green:   lower=[ 40, 80, 80]  upper=[ 80,255,255]
#   Blue:    lower=[100, 80, 80]  upper=[130,255,255]
#   Red: set DETECT_RED = True and use the two red ranges below instead
HSV_LOWER = np.array([ 40, 120, 120], dtype=np.uint8)
HSV_UPPER = np.array([ 75, 255, 255], dtype=np.uint8)  # TODO: set your colour

# Red wraps around hue=0 so it needs two ranges
DETECT_RED   = False
HSV_LOWER_R1 = np.array([  0, 80,  80], dtype=np.uint8)
HSV_UPPER_R1 = np.array([ 10, 255, 255], dtype=np.uint8)
HSV_LOWER_R2 = np.array([160, 80,  80], dtype=np.uint8)
HSV_UPPER_R2 = np.array([179, 255, 255], dtype=np.uint8)

# --- Detection thresholds ---
# Minimum bounding rectangle area in pixels² to count as a real detection.
# Raise if getting false positives, lower if it won't detect at range.
MIN_RECT_AREA = 2000    # roughly 45×45 px at 640×480

# How close the rectangle centre must be to frame centre to trigger LOCK.
# Expressed as fraction of frame size (0.0 = dead centre only, 0.5 = anywhere).
CENTRE_TOL_X = 0.30     # 30% of frame width either side of centre
CENTRE_TOL_Y = 0.30     # 30% of frame height either side of centre

# --- Loop timing ---
CONTROL_HZ     = 50
CONTROL_PERIOD = 1.0 / CONTROL_HZ

# --- Lost threshold ---
LOST_FRAMES_THRESHOLD = 15

# ═══════════════════════════════════════════════════════════════════════════════
# HARDWARE INIT
# ═══════════════════════════════════════════════════════════════════════════════

rpwm  = PWMOutputDevice(RPWM_PIN, frequency=1000)
lpwm  = PWMOutputDevice(LPWM_PIN, frequency=1000)
r_en  = OutputDevice(R_EN_PIN, initial_value=True)
l_en  = OutputDevice(L_EN_PIN, initial_value=True)

encoder     = RotaryEncoder(ENC_A_PIN, ENC_B_PIN, max_steps=0)
_last_steps = 0
_last_enc_t = time.time()

i2c = busio.I2C(board.SCL, board.SDA, frequency=100000)
imu = BNO08X_I2C(i2c)
imu.enable_feature(BNO_REPORT_GYROSCOPE)
imu.enable_feature(BNO_REPORT_ROTATION_VECTOR)

picam = Picamera2()
picam.configure(picam.create_preview_configuration(
    main={"format": "BGR888", "size": (FRAME_WIDTH, FRAME_HEIGHT)}
))
picam.start()
time.sleep(1)  # let camera warm up

# ═══════════════════════════════════════════════════════════════════════════════
# MOTOR CONTROL
# ═══════════════════════════════════════════════════════════════════════════════

def set_motor(duty: float):
    duty = max(-100.0, min(100.0, duty)) / 100.0
    if duty >= 0:
        rpwm.value = duty
        lpwm.value = 0.0
    else:
        rpwm.value = 0.0
        lpwm.value = -duty

def get_flywheel_rpm() -> float:
    global _last_steps, _last_enc_t
    now   = time.time()
    dt    = now - _last_enc_t
    steps = encoder.steps
    ticks = steps - _last_steps
    _last_steps = steps
    _last_enc_t = now
    if dt <= 0:
        return 0.0
    return (ticks / TICKS_PER_REV / dt) * 60.0

