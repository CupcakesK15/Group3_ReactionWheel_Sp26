def cleanup():
    stop_motor()
    rpwm.close()
    lpwm.close()
    r_en.close()
    l_en.close()
    encoder.close()

# ─── ENCODER / FLYWHEEL RPM ───────────────────────────────────────────────────
def get_flywheel_rpm() -> float:
    """Returns current flywheel speed in RPM (signed)."""
    global _last_steps, _last_enc_t
    now   = time.time()
    dt    = now - _last_enc_t
    steps = encoder.steps
    ticks = steps - _last_steps
    _last_steps = steps
    _last_enc_t = now
    if dt <= 0:
        return 0.0
    rps = ticks / TICKS_PER_REV / dt
    return rps * 60.0  # RPM

# ─── IMU HELPERS ─────────────────────────────────────────────────────────────
def _quat_to_R(qi, qj, qk, qr):
    """Quaternion → 3×3 rotation matrix (world-from-body)."""
    w, x, y, z = qr, qi, qj, qk
    return [
        [1-2*(y*y+z*z),   2*(x*y-z*w),   2*(x*z+y*w)],
        [  2*(x*y+z*w), 1-2*(x*x+z*z),   2*(y*z-x*w)],
        [  2*(x*z-y*w),   2*(y*z+x*w), 1-2*(x*x+y*y)],
    ]

def get_platform_omega_z() -> float | None:
    """
    Returns platform angular velocity about the true world-vertical axis
    in rad/s, or None if the IMU data isn't ready yet.
    """
    gyro = imu.gyro
    quat = imu.quaternion
    if gyro is None or quat is None:
        return None
    gx, gy, gz = gyro
    qi, qj, qk, qr = quat
    R = _quat_to_R(qi, qj, qk, qr)
    wz = R[2][0]*gx + R[2][1]*gy + R[2][2]*gz
    return wz

# ─── PID CONTROLLER ───────────────────────────────────────────────────────────
class PID:
    def __init__(self, kp, ki, kd, output_limit=100.0):
        self.kp = kp
        self.ki = ki
        self.kd = kd
        self.limit = output_limit
        self._integral   = 0.0
        self._prev_error = 0.0
        self._prev_time  = None

    def reset(self):
        self._integral   = 0.0
        self._prev_error = 0.0
        self._prev_time  = None

    def compute(self, error: float) -> float:
        """
        error  = setpoint − measurement  (setpoint is always 0 here)
        Returns motor duty cycle to apply (-limit … +limit).
        """
        now = time.time()
        if self._prev_time is None:
            dt = LOOP_PERIOD
        else:
            dt = now - self._prev_time
        if dt <= 0:
            dt = LOOP_PERIOD
        self._prev_time = now

        # Proportional
        p = self.kp * error

        # Integral (with anti-windup clamp)
        self._integral += error * dt
        max_i = self.limit / (self.ki if self.ki != 0 else 1e-9)
        self._integral = max(-max_i, min(max_i, self._integral))
        i = self.ki * self._integral

        # Derivative (on measurement to avoid derivative kick on setpoint change)
        d = self.kd * (error - self._prev_error) / dt
        self._prev_error = error

        output = p + i + d
        return max(-self.limit, min(self.limit, output))

