def _build_detection_box():
    """Return (x1, y1, x2, y2) pixel coords of the detection box."""
    bw = int(FRAME_WIDTH  * BOX_W_FRAC)
    bh = int(FRAME_HEIGHT * BOX_H_FRAC)
    cx = FRAME_WIDTH  // 2
    cy = FRAME_HEIGHT // 2
    return (cx - bw//2, cy - bh//2, cx + bw//2, cy + bh//2)

