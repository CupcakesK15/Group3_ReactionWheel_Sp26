# ─── MOTOR CONTROL ────────────────────────────────────────────────────────────
def set_motor(duty: float):
    """
    duty: -100.0 to +100.0 percent.
    Positive → flywheel spins CW (platform reacts CCW).
    Negative → flywheel spins CCW (platform reacts CW).
    """
    duty = max(-100.0, min(100.0, duty)) / 100.0
    if duty >= 0:
        rpwm.value = duty
        lpwm.value = 0.0
    else:
        rpwm.value = 0.0
        lpwm.value = -duty

def stop_motor():
    rpwm.value = 0.0
    lpwm.value = 0.0
