import lgpio
import time

# --- Configuration ---
PIN_A = 17
PIN_B = 27
CPR = 14    # Counts per revolution at the motor shaft

# --- State ---
count = 0
h = lgpio.gpiochip_open(0)

# --- Setup pins ---
lgpio.gpio_claim_input(h, PIN_A)
lgpio.gpio_claim_input(h, PIN_B)

# --- Callbacks ---
def encoder_callback(chip, gpio, level, timestamp):
    global count
    a = lgpio.gpio_read(h, PIN_A)
    b = lgpio.gpio_read(h, PIN_B)

    if gpio == PIN_A:
        if b == 0:
            count += 1
        else:
            count -= 1
    elif gpio == PIN_B:
        if a == 1:
            count += 1
        else:
            count -= 1

# --- Register edge detection (both edges, like original) ---
lgpio.gpio_claim_alert(h, PIN_A, lgpio.BOTH_EDGES)
lgpio.gpio_claim_alert(h, PIN_B, lgpio.BOTH_EDGES)
cb_a = lgpio.callback(h, PIN_A, lgpio.BOTH_EDGES, encoder_callback)
cb_b = lgpio.callback(h, PIN_B, lgpio.BOTH_EDGES, encoder_callback)

print("Reading encoder. Press Ctrl+C to stop.")
print(f"CPR: {CPR} counts/rev at motor shaft\n")

try:
    while True:
        revolutions = count / CPR
        print(f"Count: {count:6d}  |  Revolutions: {revolutions:.2f}", end='\r')
        time.sleep(0.05)

except KeyboardInterrupt:
    print("\nStopped.")

finally:
    cb_a.cancel()
    cb_b.cancel()
    lgpio.gpiochip_close(h)