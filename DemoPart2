# COLOUR CALIBRATION
# ═══════════════════════════════════════════════════════════════════════════════

def calibrate_colour():
    """
    Shows a live feed with a small crosshair box in the centre.
    Press SPACE to sample the colour under the box, then ENTER to confirm.
    The HSV range is built automatically by adding a tolerance around the sample.
    """
    global HSV_LOWER, HSV_UPPER

    SAMPLE_R = 20   # radius of sampling square (pixels)
    cx, cy   = FRAME_WIDTH // 2, FRAME_HEIGHT // 2
    samples  = []

    print("\n── COLOUR CALIBRATION ──────────────────────────────────────────")
    print("  Point the camera at the target object.")
    print("  Press SPACE to sample colour (sample multiple times for better range).")
    print("  Press ENTER to finish and continue.\n")

    while True:
        ret, frame = cap.read()
        if not ret:
            continue

        # Draw sampling box
        cv2.rectangle(frame,
                      (cx - SAMPLE_R, cy - SAMPLE_R),
                      (cx + SAMPLE_R, cy + SAMPLE_R),
                      (255, 255, 0), 2)
        cv2.putText(frame, "SPACE=sample  ENTER=done", (10, 25),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)

        if samples:
            cv2.putText(frame, f"{len(samples)} sample(s) taken", (10, 55),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

        cv2.imshow("Calibration", frame)
        key = cv2.waitKey(1) & 0xFF

        if key == ord(' '):
            roi  = frame[cy-SAMPLE_R:cy+SAMPLE_R, cx-SAMPLE_R:cx+SAMPLE_R]
            hsv  = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
            mean = cv2.mean(hsv)[:3]
            samples.append(mean)
            print(f"  Sampled HSV: H={mean[0]:.1f}  S={mean[1]:.1f}  V={mean[2]:.1f}")

        elif key == 13 and samples:   # ENTER
            break

    cv2.destroyWindow("Calibration")

    # Build range from all samples + tolerance
    H_TOL, S_TOL, V_TOL = 15, 60, 60
    h_vals = [s[0] for s in samples]
    s_vals = [s[1] for s in samples]
    v_vals = [s[2] for s in samples]

    HSV_LOWER = np.array([
        max(0,   min(h_vals) - H_TOL),
        max(0,   min(s_vals) - S_TOL),
        max(0,   min(v_vals) - V_TOL),
    ], dtype=np.uint8)
    HSV_UPPER = np.array([
        min(179, max(h_vals) + H_TOL),
        255,
        255,
    ], dtype=np.uint8)

    print(f"\n  HSV_LOWER = {HSV_LOWER}")
    print(f"  HSV_UPPER = {HSV_UPPER}")
    print("────────────────────────────────────────────────────────────────\n")

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN — state machine + control loop
# ═══════════════════════════════════════════════════════════════════════════════

# States
SEARCH = "SEARCH"   # spinning slowly, looking for ball
LOCKED = "LOCKED"   # ball found, stabiliser holds position
LOST   = "LOST"     # ball was locked but disappeared — re-search

# How many consecutive "not detected" frames before dropping lock
LOST_FRAMES_THRESHOLD = 15

def main():
    # ── Calibration ──────────────────────────────────────────────────────────
    if not MANUAL_HSV:
        calibrate_colour()
    else:
        print(f"Using manual HSV range: {HSV_LOWER} → {HSV_UPPER}")

    # ── Start camera thread ───────────────────────────────────────────────────
    cam_thread = threading.Thread(target=camera_thread_fn, daemon=True)
    cam_thread.start()
    print("Camera thread started.")

    # ── Warm up IMU ──────────────────────────────────────────────────────────
    print("Warming up IMU for 3 seconds — keep platform still...")
    time.sleep(3)

    pid         = PID(Kp, Ki, Kd, limit=MAX_DUTY)
    state       = SEARCH
    lost_count  = 0

    print(f"\nStarting in state: {SEARCH}")
    print(f"{'Time':>7} | {'State':>8} | {'ω_z (rad/s)':>12} | "
          f"{'Fill %':>7} | {'Motor %':>8}")
    print("-" * 56)

    try:
        while True:
            t0 = time.time()

            # ── Read sensors ──────────────────────────────────────────────
            omega_z  = get_platform_omega_z()
            detected, fill_pct = get_detection()
            #TODO: replace the line right above with the line right below
            #detected, fill_pct, left_det, right_det = get_detection()

            if omega_z is None:
                time.sleep(0.005)
                continue

            # ── State machine ─────────────────────────────────────────────
            if state == SEARCH:
                lost_count = 0
                pid.reset()

                if detected:
                    # Ball found — transition to LOCKED
                    state = LOCKED
                    stop_motor()
                    pid.reset()
                    print(f"\n  ★ Ball found! Switching to LOCKED (fill={fill_pct*100:.1f}%)")
                    motor_out = 0.0
                #TODO: uncomment this stuff and get rid of the original else for smart searching
                # elif left_det and not right_det:
                #     set_motor(-SEARCH_DUTY)   # ball is left of centre — spin left
                #     motor_out = -SEARCH_DUTY
                # elif right_det and not left_det:
                #     set_motor(+SEARCH_DUTY)   # ball is right of centre — spin right
                #     motor_out = +SEARCH_DUTY
                # else:
                #     set_motor(+SEARCH_DUTY)   # nothing visible — default spin
                #     motor_out = +SEARCH_DUTY
                else:
                    # Keep spinning to scan
                    set_motor(SEARCH_DUTY)
                    motor_out = SEARCH_DUTY

            elif state == LOCKED:
                if not detected:
                    lost_count += 1
                    if lost_count >= LOST_FRAMES_THRESHOLD:
                        state = LOST
                        print(f"\n  ✗ Ball lost! Switching to SEARCH")
                else:
                    lost_count = 0

                # Stabiliser holds position regardless of whether ball is
                # momentarily obscured (within the LOST_FRAMES window)
                if abs(omega_z) < DEAD_BAND_RAD_S:
                    pid.reset()
                    stop_motor()
                    motor_out = 0.0
                else:
                    error     = -omega_z
                    motor_out = pid.compute(error)
                    set_motor(motor_out)

            elif state == LOST:
                # Brief pause, then go back to searching
                stop_motor()
                time.sleep(0.5)
                pid.reset()
                state      = SEARCH
                lost_count = 0
                motor_out  = 0.0

            # ── Display ───────────────────────────────────────────────────
            frame = get_latest_frame()
            if frame is not None:
                # Overlay state info on frame
                state_colour = (0, 255, 0) if state == LOCKED else (0, 165, 255)
                cv2.putText(frame, f"State: {state}", (10, FRAME_HEIGHT - 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.65, state_colour, 2)
                cv2.putText(frame, f"omega_z: {math.degrees(omega_z):+.2f} deg/s",
                            (10, FRAME_HEIGHT - 15),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 1)
                cv2.imshow("Reaction Wheel Tracker", frame)
                if cv2.waitKey(1) & 0xFF == ord('q'):
                    print("\nQ pressed — quitting.")
                    break

            # ── Console log ───────────────────────────────────────────────
            print(f"{time.time():>7.2f} | {state:>8} | {omega_z:>+12.4f} | "
                  f"{fill_pct*100:>6.1f}% | {motor_out:>+8.1f}",
                  end="\r")

            # ── Pace loop ─────────────────────────────────────────────────
            elapsed = time.time() - t0
            if CONTROL_PERIOD - elapsed > 0:
                time.sleep(CONTROL_PERIOD - elapsed)

    except KeyboardInterrupt:
        print("\n\nInterrupted — shutting down.")

    finally:
        cleanup()
        print("Done.")

if __name__ == "__main__":
    main()