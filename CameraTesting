# Run this separately to test colour detection without the motor/IMU
# python3 debug_colour.py

import cv2
import numpy as np
import time
from picamera2 import Picamera2

CAMERA_INDEX = 0
FRAME_WIDTH  = 640
FRAME_HEIGHT = 480

HSV_LOWER = np.array([ 40, 120, 120], dtype=np.uint8)
HSV_UPPER = np.array([ 75, 255, 255], dtype=np.uint8)
MIN_RECT_AREA = 4000

# cap = cv2.VideoCapture(CAMERA_INDEX)
cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
cap.set(cv2.CAP_PROP_FRAME_WIDTH,  FRAME_WIDTH)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)

kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))

print("Reading frames — point camera at green object. Ctrl-C to stop.\n")
print(f"{'Frame':>6} | {'Contours found':>14} | {'Largest area':>12} | {'Detected':>8}")
print("-" * 50)

frame_num = 0
while True:
    ret, frame = cap.read()
    if not ret:
        print("Camera read failed")
        time.sleep(0.1)
        continue

    hsv  = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    mask = cv2.inRange(hsv, HSV_LOWER, HSV_UPPER)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN,  kernel)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL,
                                   cv2.CHAIN_APPROX_SIMPLE)

    # Also print the average HSV of the centre of the frame
    # so you can see what colour the camera actually sees
    cx, cy = FRAME_WIDTH // 2, FRAME_HEIGHT // 2
    sample = hsv[cy-10:cy+10, cx-10:cx+10]
    avg_h  = int(np.mean(sample[:,:,0]))
    avg_s  = int(np.mean(sample[:,:,1]))
    avg_v  = int(np.mean(sample[:,:,2]))

    largest = 0
    for cnt in contours:
        x, y, w, h = cv2.boundingRect(cnt)
        largest = max(largest, w * h)

    detected = largest >= MIN_RECT_AREA
    print(f"{frame_num:>6} | {len(contours):>14} | {largest:>12} | {str(detected):>8} "
          f"| centre HSV=({avg_h},{avg_s},{avg_v})")

    frame_num += 1
    time.sleep(0.2)   # 5 fps so terminal is readable

cap.release()