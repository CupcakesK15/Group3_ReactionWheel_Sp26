import RPi.GPIO as GPIO
import board
import busio
import time
from adafruit_bno08x import BNO_REPORT_GYROSCOPE
from adafruit_bno08x.i2c import BNO08X_I2C

# --- Pins ---
MOTOR_PWM_R = 12 # Pin for Forward
MOTOR_PWM_L = 13 # Pin for Backward
ENC_A = 17
ENC_B = 27

# --- Setup GPIO ---
GPIO.setmode(GPIO.BCM)
GPIO.setup([MOTOR_PWM_R, MOTOR_PWM_L], GPIO.OUT)
pwm_r = GPIO.PWM(MOTOR_PWM_R, 1000) # 1kHz frequency
pwm_l = GPIO.PWM(MOTOR_PWM_L, 1000)
pwm_r.start(0)
pwm_l.start(0)

# --- Setup IMU ---
i2c = busio.I2C(board.SCL, board.SDA)
bno = BNO08X_I2C(i2c)
bno.enable_feature(BNO_REPORT_GYROSCOPE)

def set_motor(speed):
    """Speed from -100 to 100"""
    if speed >= 0:
        pwm_r.ChangeDutyCycle(speed)
        pwm_l.ChangeDutyCycle(0)
    else:
        pwm_r.ChangeDutyCycle(0)
        pwm_l.ChangeDutyCycle(abs(speed))

try:
    print("Ramping up motor... watch the platform spin opposite!")
    for s in range(0, 50, 5): # Ramp up to 50% power
        set_motor(s)
        time.sleep(0.5)
        
        # Get Platform Speed
        gyro_x, gyro_y, gyro_z = bno.gyro
        print(f"Motor Power: {s}% | Platform Yaw Velocity: {gyro_z:.4f} rad/s")

    time.sleep(2)
    set_motor(0)

finally:
    pwm_r.stop()
    pwm_l.stop()
    GPIO.cleanup()



